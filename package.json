{
  "name": "dsh-schedule-send",
  "version": "1.0.0",
  "description": "Defer a DSH composer message to DeepSeek's half-price off-peak hours as a one-shot @deepseek-ai/dsh-schedule task, registered without spending a model turn.",
  "type": "module",
  "icon": "icon.svg",
  "author": "geodaoyu",
  "license": "MIT",
  "homepage": "https://github.com/geodaoyu/dsh-schedule-send",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geodaoyu/dsh-schedule-send.git"
  },
  "bugs": {
    "url": "https://github.com/geodaoyu/dsh-schedule-send/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "schedule",
    "off-peak",
    "timer",
    "composer",
    "ui"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
